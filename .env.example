# Nothing here is required for the static demo (`npm run dev` or `npm run build`).
# Fill these only when you wire the reference architecture.

# Supabase Auth + Postgres. The anon key is public by design.
# The service role key and the JWT secret stay on the server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# mock (default) or openai. The OpenAI key is read only inside the audit function.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_QUOTA=20

# Demo tokens (demo.<userId>) are rejected when this is false, and also when
# AI_PROVIDER=openai. Leave true only on a showcase deploy.
ALLOW_DEMO_TOKENS=true

# Optional. Tests use the SQLite fixture and never open this URL.
# TARGET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vale_verde
